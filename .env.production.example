# =====================================================================
# 生产环境变量模板 —— 复制为服务器上的 .env 后逐一填值。
#   cp .env.production.example .env && nano .env
# 安全要求：
#   * 每个值都是独立生成的强随机串，禁止复用开发环境的值；
#   * 本文件不得提交 Git（已在 .gitignore 忽略 .env*，但请勿改回）；
#   * 项目上线前务必重置开发阶段使用过的全部密钥。
# 生成强随机值（PowerShell）：
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) | Set-Content)... 
#   更稳妥： openssl rand -base64 48
# =====================================================================

# ========== HTTPS / 域名 ==========
# 正式域名，Nginx 证书挂载路径见 docker/nginx/nginx.conf
FRONTEND_URL=https://gis.example.com
# 允许跨域来源（必须与正式域名一致，逗号分隔多个）
AUTH_CORS_ORIGINS=https://gis.example.com

# ========== 登录鉴权（必填） ==========
# JWT 签名密钥：>= 64 字节强随机串（openssl rand -base64 48）
AUTH_JWT_SECRET=
# 令牌有效期（分钟）
AUTH_JWT_TTL_MINUTES=720
# 引导管理员（首次启动用，正式上线后通过 /api/auth/users 建普通用户）
AUTH_ADMIN_USERNAME=admin
# 引导管理员密码（强口令，>= 16 位）
AUTH_ADMIN_PASSWORD=

# ========== 全局限流 ==========
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_EXCLUDE_HEALTH_CHECK=true

# ========== 上传安全加固 ==========
# 病毒扫描（如部署 ClamAV REST 网关后启用）
UPLOAD_AV_ENABLED=false
UPLOAD_AV_URL=http://clamav:9444
UPLOAD_AV_TIMEOUT_MS=4000
# 配额（字节，-1 不限制）
UPLOAD_GLOBAL_QUOTA_BYTES=-1
UPLOAD_PER_USER_QUOTA_BYTES=-1
UPLOAD_QUOTA_WINDOW_SECONDS=3600
# 托管文件保留与清理
UPLOAD_FILE_RETENTION_SECONDS=86400
UPLOAD_CLEANUP_ENABLED=true
UPLOAD_CLEANUP_INTERVAL_SECONDS=3600

# ========== 数据库 / 缓存（必填） ==========
# 生产由 compose-prod.yaml 强制覆盖 host 为 pgvector / redis，密码来自此处
POSTGRES_PASSWORD=
POSTGRES_USER=postgres
REDIS_PASSWORD=

# ========== LLM 提供商 ==========
# Qwen / DashScope。保持变量名与代码读取名一致。
QWEN-APIKEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek 备用路由
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ROUTER_MODEL=deepseek-v4-flash

# ========== 地图 / 第三方 ==========
AMAP_KEY=

# ========== 空间知识图谱 ==========
SPATIAL_KNOWLEDGE_GRAPH_URL=
SPATIAL_KNOWLEDGE_GRAPH_ADMIN_MODE=false
SPATIAL_KNOWLEDGE_GRAPH_ADMIN_TOKEN=
SPATIAL_KNOWLEDGE_GRAPH_REFRESH_TTL_SECONDS=600
# Atlas GIS MCP（如启用）
ATLAS_GIS_MCP_URL=
ATLAS_GIS_MCP_SEARCH_TOOL=

# ========== CityEngine / GeoScene（宿主机运行） ==========
# python-gis 容器通过 host.docker.internal 反向访问宿主机服务，见 compose-prod.yaml。
# CityEngine 工作区（挂载共享目录）
CITYENGINE_WORKSPACE=./cityengine-workspace
CITYENGINE_PROJECT=./cityengine-project
CITYENGINE_RUNTIME_ROOT=
# 正式 GeoScene 门户凭据（上线前必须重置为生产专用账号）
GEOSCENE_PORTAL_URL=
GEOSCENE_PORTAL_USERNAME=
GEOSCENE_PORTAL_PASSWORD=
GEOSCENE_PORTAL_FOLDER=GISAgent-CityEngine
GEOSCENE_VERIFY_SSL=false

# ========== 其它可调 ==========
SERVER_ADDRESS=0.0.0.0
POSTGRES_URL=jdbc:postgresql://pgvector:5432/vectordb
POSTGRES_HOST=pgvector
REDIS_HOST=redis
REDIS_PORT=6379
GIS_PYTHON_SERVICE_URL=http://python-gis:8000/analysis
SPATIAL_DEMO_ENABLED=false
