# ===== 本地竞赛版（免登录） =====
# API 默认本地免登录（AUTH_ENABLED=false，所有本地 API 直接可用）；
# 生产必须 AUTH_ENABLED=true 并配齐下方 JWT 密钥，或由反向代理鉴权。
# 生成：openssl rand -base64 48   （或 PowerShell: openssl rand -base64 40）
# 令牌有效期（分钟，默认 720 = 12 小时）
# 允许跨域来源（逗号分隔）。生产只允许正式域名，例如：
# AUTH_CORS_ORIGINS=https://gis.example.com
AUTH_ENABLED=false
AUTH_JWT_SECRET=
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=
AUTH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 上传安全加固 =====
# 深格式校验始终生效；病毒扫描需配置 UPLOAD_AV_URL 后启用 UPLOAD_AV_ENABLED=true
UPLOAD_AV_ENABLED=false
UPLOAD_AV_URL=
UPLOAD_AV_TIMEOUT_MS=4000
# 配额（字节）：-1 表示不限制
UPLOAD_GLOBAL_QUOTA_BYTES=-1
UPLOAD_PER_USER_QUOTA_BYTES=-1
UPLOAD_QUOTA_WINDOW_SECONDS=3600
# 托管上传文件保留与清理
UPLOAD_FILE_RETENTION_SECONDS=86400
UPLOAD_CLEANUP_ENABLED=true
UPLOAD_CLEANUP_INTERVAL_SECONDS=3600

# ===== 生产容器（compose-prod.yaml）=====
# PostgreSQL / Redis 强随机密码（生产必填）
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# 容器内服务名（无需修改）
POSTGRES_HOST=pgvector
REDIS_HOST=redis

# ===== GIS / 空间分析 =====
# DashScope/Qwen API key. Keep the variable name exactly as QWEN-APIKEY.
QWEN-APIKEY=replace-with-your-key
# Optional dedicated GIS routing model.
DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ROUTER_MODEL=deepseek-v4-flash
# 生产：Python GIS 走容器内网（compose-prod.yaml 用 http://python-gis:8000/analysis）
GIS_PYTHON_SERVICE_URL=http://127.0.0.1:8000/analysis
# PostgreSQL 连接（生产由 compose-prod.yaml 覆盖，指向 pgvector 服务）
POSTGRES_URL=jdbc:postgresql://127.0.0.1:5432/vectordb
POSTGRES_USER=postgres

# Remote spatial knowledge graph. Host the JSON template below at an HTTPS URL,
# then set this value. Empty keeps the reviewed bundled graph active.
# Template: src/main/resources/spatial-capabilities.remote-template.json
SPATIAL_KNOWLEDGE_GRAPH_URL=
SPATIAL_KNOWLEDGE_GRAPH_REFRESH_TTL_SECONDS=300
# Use token mode with a separate random token before exposing publication APIs.
SPATIAL_KNOWLEDGE_GRAPH_ADMIN_MODE=local
SPATIAL_KNOWLEDGE_GRAPH_ADMIN_TOKEN=

# Docker is started separately by start-docker.bat. Set to 1 for optional all-in-one launch.
GIS_AUTO_START_DOCKER=0

# 离线演示数据开关：竞赛/演示环境必须 true（提供 6 栋建筑 demo-case 与
# /api/gis/offline-case 端点，acceptance-offline.ps1 验收依赖）。
# 共享或生产部署保持 false。
SPATIAL_DEMO_ENABLED=true

# Keep this path ASCII-only. Each CityEngine job gets an isolated workspace below it.
CITYENGINE_RUNTIME_ROOT=C:/GISAgentCityEngine
# Cold CityEngine boot can rebuild Python support files for 2-3 minutes.
CITYENGINE_BOOT_TIMEOUT_SECONDS=300
# Budget starts only after GISAgent installs the CityEngine startup hook.
CITYENGINE_AUTOMATION_TIMEOUT_SECONDS=120
CITYENGINE_JOB_TIMEOUT_SECONDS=900
CITYENGINE_KEEP_RUNTIME_CACHE=false

# Optional GeoScene ArcPy runtime for metric computation. When set, the GIS
# service runs under this interpreter and arcpy becomes the preferred backend.
# Defaults to the bundled GeoScene Pro Python:
#   C:\Program Files\GeoScene\Pro\bin\Python\envs\arcgispro-py3\python.exe
# Unset this to fall back to the local .venv (open-source GeoPandas/Shapely).
# GIS_PYTHON_EXE=C:\Program Files\GeoScene\Pro\bin\Python\envs\arcgispro-py3\python.exe

# GeoScene Enterprise publishing. Keep real credentials in the ignored .env file.
# GeoScene is the display/publishing platform for hosted 3D scene services
# (SLPK/SceneServer). Metric and geometry math prefers the local ArcPy runtime
# and falls back to open-source GeoPandas/Shapely; GeoScene Server is NOT a
# computation backend.
GEOSCENE_PORTAL_URL=https://your-geoscene-host/geoscene
GEOSCENE_PORTAL_USERNAME=your-portal-user
GEOSCENE_PORTAL_PASSWORD=your-portal-password
GEOSCENE_PORTAL_FOLDER=GISAgent-CityEngine
GEOSCENE_VERIFY_SSL=false
# 发布器校验对象存储时使用的 Server 管理 API（默认指向云端，本地部署必须覆盖）。
# 例如本机 Tomcat 版 Enterprise：https://localhost:6443/geoscene/admin
GEOSCENE_SERVER_ADMIN_URL=https://your-geoscene-host:6443/geoscene/admin
# 对象存储描述符：优先从环境变量读取，避免发布器调用需要管理员权限的
# describedatastore。获取方式：管理员运行 DataStore tools\describedatastore.bat，
# "Information for object store <ID>" 行即为 ID，机器名为 Registered machines 行。
GEOSCENE_OBJECT_STORE_ID=
GEOSCENE_OBJECT_STORE_MACHINE=
# Server-side Geometry Service metrics are officially unavailable and disabled.
# Do not re-enable unless the GeoScene server runtime is repaired and verified.
GEOSCENE_SERVER_METRICS_ENABLED=false
# Publishing preflight rejects old GISAgent-owned partial jobs instead of
# waiting for the object store until timeout. Automatic cancellation remains
# opt-in because it changes Portal/Server state.
GEOSCENE_STALE_PUBLICATION_MIN_AGE_SECONDS=600
GEOSCENE_AUTO_CANCEL_STALE_PUBLICATIONS=false
GEOSCENE_DELETE_CANCELLED_PARTIAL_ITEMS=false

# ===== 动态代码执行安全开关（默认值以最小风险为准）=====
# 是否启用动态代码执行。生产/公网务必保持 false。
DYNAMIC_EXECUTION_ENABLED=false
# 鉴权模式：token=独立令牌；local=仅本机回环地址。
DYNAMIC_EXECUTION_AUTH_MODE=local
# token 模式下的独立执行令牌，绝不复用 QWEN-APIKEY。
GIS_AGENT_EXEC_TOKEN=
# 单次执行硬超时（毫秒），超时后强制终止 GraalJS。
DYNAMIC_EXECUTION_TIMEOUT_MS=3000
# 服务绑定地址，local 鉴权仅允许该地址或回环地址触发。
SERVER_ADDRESS=127.0.0.1
# 输入/输出大小限制与并发控制（可按需调整）。
DYNAMIC_EXECUTION_MAX_INPUT_BYTES=65536
DYNAMIC_EXECUTION_MAX_OUTPUT_BYTES=65536
DYNAMIC_EXECUTION_MAX_CONCURRENCY=4
DYNAMIC_EXECUTION_POOL_SIZE=4
